# OpenRouter — the LLM provider for NL planning (issue #18). Copy to `.env`
# and fill in. Never commit real keys.
OPENROUTER_API_KEY=

# Planner model (any tool-calling-capable OpenRouter model id). Balanced
# cost/performance default lives in api.agent.provider; override here.
PLANNER_MODEL=openai/gpt-oss-120b
