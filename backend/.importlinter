[importlinter]
include_external_packages = True
root_packages =
    utils
    rules_core
    rules_data
    mcp_server
    agui
    agent
    shell

[importlinter:contract:1]
name = rules_core is pure: no contract, no adapters, no DB, no clock/env/randomness (ADR-0002 §3, §7)
type = forbidden
source_modules =
    rules_core
forbidden_modules =
    utils.contract
    mcp_server
    agent
    shell
    agui
    sqlite3
    sqlalchemy
    psycopg
    psycopg2
    asyncpg
    httpx
    datetime
    time
    random
    secrets
    os

[importlinter:contract:2]
name = no DB driver in the rules namespace (ADR-0002 §7; the pool belongs to corpus, deferred)
type = forbidden
source_modules =
    rules_core
    mcp_server.rules
forbidden_modules =
    sqlite3
    sqlalchemy
    psycopg
    psycopg2
    asyncpg
