[importlinter]
include_external_packages = True
root_packages =
    utils
    domains
    mcp_server
    api

[importlinter:contract:1]
name = every domain core is pure: no contract, no adapters, no DB, no clock/env/randomness (ADR-0003 §3; ADR-0002 §3, §7)
type = forbidden
source_modules =
    domains.*.core
forbidden_modules =
    utils.contract
    mcp_server
    api
    sqlite3
    sqlalchemy
    psycopg
    psycopg2
    asyncpg
    httpx
    datetime
    time
    random
    secrets
    os

[importlinter:contract:2]
name = no DB driver in the domain cores or the rules adapter (ADR-0002 §7; the pool belongs to corpus, deferred)
type = forbidden
source_modules =
    domains.*.core
    mcp_server.rules
forbidden_modules =
    sqlite3
    sqlalchemy
    psycopg
    psycopg2
    asyncpg
